# SplitStack Server Environment Configuration (Review 3)
# Copy this file to .env and adjust variables as needed for your environment.

# Server runtime mode: development | production | test
NODE_ENV=development

# Server port and bind host
PORT=3000
HOST=localhost

# MongoDB connection string (Required in Phase P10)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/splitstack-dev?retryWrites=true&w=majority
# Example local format: mongodb://127.0.0.1:27017/splitstack-dev
# MONGODB_URI=

# Session Secret (Required in Phase P11)
# Must be a cryptographically random string of at least 32 characters
# SESSION_SECRET=
