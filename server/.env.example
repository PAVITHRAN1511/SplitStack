# SplitStack Server Environment Configuration (Review 3)
# Copy this file to .env and adjust variables as needed for your environment.

# Server runtime mode: development | production | test
NODE_ENV=development

# Server port and bind host
PORT=3000
HOST=localhost

# MongoDB connection string (Phase P10)
# Local development default (fake local instance):
MONGODB_URI=mongodb://127.0.0.1:27017/splitstack-dev
# MongoDB Atlas example template (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/splitstack-dev?retryWrites=true&w=majority

# Authentication & Security (Phase P11)
# Cryptographically random strings (min 32 characters in production)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-random-cookie-secret-at-least-32-chars
